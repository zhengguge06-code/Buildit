# Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
NEXT_PUBLIC_SITE_URL=https://your-public-domain.example

# Product Hunt API
# Use either PRODUCT_HUNT_ACCESS_TOKEN, or PRODUCT_HUNT_CLIENT_ID + PRODUCT_HUNT_CLIENT_SECRET.
PRODUCT_HUNT_ACCESS_TOKEN=your-product-hunt-access-token
PRODUCT_HUNT_CLIENT_ID=your-product-hunt-client-id
PRODUCT_HUNT_CLIENT_SECRET=your-product-hunt-client-secret
